# Copy this file to .env and replace example values.

DB_ROOT_PASS=change-this-root-password
DB_NAME=rddtsync
DB_USER=synccit
DB_PASS=change-this-app-password

# App URL settings
BASE_URL=
BASE_HOST=https://synccit.example.com
API_LOC=https://synccit.example.com/api/

# SMTP settings (for password reset emails)
SMTP_SERVER=smtp.gmail.com
SMTP_AUTH=true
SMTP_USER=noreply@synccit.example.com
SMTP_PASS=change-this-smtp-password
SMTP_ENC=ssl
SMTP_PORT=465
FROM_EMAIL=noreply@synccit.example.com
